generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  firebaseUid        String            @unique
  email              String?
  isAnonymous        Boolean           @default(false)
  username           String?
  usernameNormalized String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastSeenAt         DateTime?
  mergedIntoUserId   String?           @db.Uuid
  mergedIntoUser     User?             @relation("UserMerges", fields: [mergedIntoUserId], references: [id])
  mergedUsers        User[]            @relation("UserMerges")
  profile            PlayerProfile?
  runs               Run[]
  guestMergeTokens   GuestMergeToken[] @relation("GuestMergeTokenGuest")
  communityMaps      CommunityMap[]
  communityRatings CommunityMapRating[]
  communityReports CommunityMapReport[]
}

model CommunityMap {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(13)
  ownerId       String   @db.Uuid
  requestId     String   @db.Uuid
  payloadHash   String   @db.VarChar(64)
  name          String   @db.VarChar(24)
  description   String   @db.VarChar(500)
  creatorName   String   @db.VarChar(64)
  visibility    String   @db.VarChar(8)
  document      Json
  published     Boolean  @default(true)
  hidden        Boolean  @default(false)
  downloads     Int      @default(0)
  ratingSum     Int      @default(0)
  ratingCount   Int      @default(0)
  ratingRank    Float    @default(3.5)
  moderationReason String? @db.VarChar(500)
  searchVector Unsupported("tsvector") @default(dbgenerated())
  ratings       CommunityMapRating[]
  imports       CommunityMapDownload[]
  reports       CommunityMapReport[]
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  unpublishedAt DateTime? @db.Timestamptz(3)
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([ownerId, requestId])
  @@index([ownerId, createdAt, id])
  @@index([visibility, published, createdAt, id])
  @@index([visibility, published, hidden, ratingRank, createdAt, id], map: "CommunityMap_visibility_published_hidden_ratingRank_createdAt_i")
  @@index([visibility, published, hidden, downloads, createdAt, id], map: "CommunityMap_visibility_published_hidden_downloads_createdAt_id")
  @@index([searchVector], type: Gin, map: "CommunityMap_search_idx")
}

model CommunityMapRating {
  mapId String @db.Uuid
  userId String @db.Uuid
  stars Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  map CommunityMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([mapId, userId])
}

model CommunityMapDownload {
  mapId String @db.Uuid
  actorHash String @db.VarChar(64)
  requestId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  map CommunityMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  @@id([mapId, actorHash])
  @@unique([mapId, requestId])
}

model CommunityMapReport {
  mapId String @db.Uuid
  userId String @db.Uuid
  reason String @db.VarChar(32)
  notes String @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  map CommunityMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([mapId, userId])
  @@index([createdAt, mapId, userId])
}

model PlayerProfile {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @db.Uuid
  bestScore                Int      @default(0)
  bestLevel                Int      @default(1)
  gamesPlayed              Int      @default(0)
  totalPoints              Int      @default(0)
  totalLinesCleared        Int      @default(0)
  totalContractsCompleted  Int      @default(0)
  totalBombsUsed           Int      @default(0)
  totalMegaBombsUsed       Int      @default(0)
  totalRiskSpinsUsed       Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id])
}

model Run {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  score              Int
  level              Int
  linesCleared       Int      @default(0)
  contractsCompleted Int      @default(0)
  bombsUsed          Int      @default(0)
  megaBombsUsed      Int      @default(0)
  riskSpinsUsed      Int      @default(0)
  boardSize          Int      @default(8)
  durationSeconds    Int?
  appVersion         String?
  validationStatus   String   @default("accepted")
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([score])
  @@index([boardSize, score])
}

model GuestMergeToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  guestUserId String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  guestUser   User      @relation("GuestMergeTokenGuest", fields: [guestUserId], references: [id])

  @@index([guestUserId])
  @@index([expiresAt])
}
