NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://gridfall:gridfall_dev_password@localhost:5432/gridfall?schema=public
POSTGRES_PASSWORD=gridfall_dev_password
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
CORS_ORIGINS=http://localhost:3000
# Community import deduplication: generate a stable random value (at least 32 characters).
COMMUNITY_DOWNLOAD_SECRET=

# Explicit environment-specific mounts; never reuse production storage for staging.
GRIDFALL_DATABASE_STORAGE=
GRIDFALL_FIREBASE_CREDENTIALS_FILE=
